# Copie para .env (NUNCA commitar). Segredos NÃO ficam aqui: ficam em arquivos
# dentro de ${DATA_DIR}/secrets/ (ver infra/secrets/README na Fase 1).

# Pasta de dados vivos — FORA de OneDrive / Google Drive. Barras normais no Windows.
DATA_DIR=C:/giraffas-erp-data

APP_ENV=producao
APP_VERSION=latest

POSTGRES_USER=erp
POSTGRES_DB=erp
APP_DB_USER=erp_app
N8N_DB=n8n
N8N_DB_USER=n8n

# Portas no host (127.0.0.1) — diferentes do sistema atual para rodar em paralelo
API_HOST_PORT=8100
POSTGRES_HOST_PORT=55433
CONSOLE_HOST_PORT=8501
N8N_HOST_PORT=5678
NOVNC_HOST_PORT=6080

API_WORKERS=2
WORKER_CONCORRENCIA=2
JWT_EXPIRE_MINUTES=480

N8N_VERSION=latest
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/

# Fase 2 (sombra): pasta 01_entrada do sistema atual, montada SOMENTE LEITURA no worker
# LEGADO_ENTRADA_DIR=G:/Meu Drive/1-RSIN(holding)/3-Rodiza - Giraffas/Gestao/Giraffas-Datalake/01_entrada
